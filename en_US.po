msgstr "Gah-hoo-hoo!"

msgctxt "707Z006"
msgid "AHHHHHHHHH"
msgstr "AHHHHHHHHH"

msgctxt "707Z006B"
msgid "Hi-ya!"
msgstr "Hi-ya!"

msgctxt "707Z007"
msgid "God! Have you gone insane? What is the matter with you?"
msgstr "God! Have you gone insane? What is the matter with you?"

msgctxt "707Z008"
