"voller Murmeln."
msgstr ""
"The bag is already\n"
"full of marbles."

msgctxt "object:82:33"
msgid ""
"Der Beutel ist schon\n"
"voller Murmeln."
msgstr ""
"The bag is already\n"
"full of marbles."

msgctxt "object:82:35"
msgid ""
"Der Beutel ist schon\n"
"voller Murmeln."
msgstr ""
"The bag is already\n"
"full of marbles."

msgctxt "object:82:37"
msgid ""
"Der Beutel ist schon\n"
"voller Murmeln."
msgstr ""
"The bag is already\n"
"full of marbles."

msgctxt "object:82:39"
msgid ""
"Der Beutel ist schon\n"
"voller Murmeln."
msgstr ""
