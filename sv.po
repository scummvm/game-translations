msgctxt "object:110:0"
msgid ""
"Das ist Mrs. Butler."
msgstr "Det är mrs Butler."

msgctxt "object:111:0"
msgid ""
"Eine Handvoll Murmeln."
msgstr "En handfull kulor."

msgctxt "object:112:0"
msgid ""
"Alte Musketen, zwar sind\n"
"das nur Vorderlader, aber\n"
"die krachen genauso, wenn\n"
"es darauf ankommt."
msgstr ""
"Gamla musköter. Visserligen är\n"
"de bara mynningsladdare, men\n"
"de smäller lika bra\n"
"när det behövs."

msgctxt "object:113:0"
msgid ""
"Ein stabiler Holz-\n"
"pfahl, der an einem\n"
"Ende angespitzt ist."
msgstr ""
"En stadig träpåle\n"
"som är vässad\n"
"i ena änden."

msgctxt "object:113:3"
msgid ""
"Damit kann ich doch das Ding\n"
"nicht zerkleinern."
msgstr ""
"Jag kan väl inte krossa\n"
"saken med det."

msgctxt "object:113:5"
msgid ""
